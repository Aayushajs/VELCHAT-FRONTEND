# dependencies
node_modules/
.pnpm-store/

# turbo / build caches
.turbo/
dist/
coverage/

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# env — commit PUBLIC flavor configs (.env.dev/.env.stage/.env.prod, base URLs only);
# never commit secrets or local overrides.
.env
.env.local
.env.*.local
!.env.example
*.keystore
!debug.keystore

# react native / metro
apps/*/.expo/
apps/*/ios/Pods/
apps/*/ios/build/
apps/*/android/.gradle/
apps/*/android/app/build/
apps/*/android/build/
apps/*/android/local.properties
apps/*/**/*.hprof
.metro-health-check*
metro-cache/

# reassure / perf
.reassure/

# fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Built APKs. Release artefacts, not source — and a 31MB binary per build would make every
# clone carry the history of every test build.
apk-out/

# QA local config — holds Jira/BrowserStack/Google credentials. NEVER commit.
QA/config/qa.env
QA/config/*.json
QA/reports/results.jsonl
QA/evidence/**
!QA/evidence/**/.gitkeep

# QA sync bookkeeping (§ Excel/Sheets two-way sync) — pure local state, regenerated on every run,
# meaningless without the local machine's edit history. bugs.json and the .xlsx ARE committed
# (they're the actual QA registry/report); only the internal "who wrote this last" ledgers aren't.
QA/reports/.excel_state.json
QA/reports/.sheets_state.json
QA/reports/.sync_bridge.json
QA/reports/~$*
