<resources>

    <!-- Android 12+ splash screen: exact black VelChat brand field + mark. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Must be declared: left out, this inherits AppCompat's #FAFAFA and that
             near-white gets painted in the gap between the system splash being
             dismissed and React Native drawing its first frame. -->
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <!-- The supplied mark's own field, shared with the launcher icon so the two
             can never drift apart. -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- System navigation bar = the app's bottom tab surface (light). -->
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
