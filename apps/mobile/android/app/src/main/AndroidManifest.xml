<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime notification permission (Android 13+ / API 33). Requested on the
         Notifications onboarding step via PermissionsAndroid. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Light haptic feedback on step/tab transitions (Vibration API). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Media capture + voice/video calls. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Contact discovery (find which contacts are on VelChat) — salted hashes only. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lets the app ASK to be exempt from battery optimisation (ADR 0008).
         Load-bearing, not a nicety: with the app in Doze or under an OEM's aggressive power
         manager, FCM reports a data message as delivered and the OS never starts our
         FirebaseMessagingService. The result is no notification AND no delivery receipt — so the
         sender is stuck on one tick for a message that genuinely reached the handset. This is the
         same exemption WhatsApp requests, and it is the only part of that problem an app can fix
         for itself; per-OEM "Autostart" still has to be granted by hand. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Bluetooth audio routing during calls (Android 12+ runtime permission). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- §M17 deep links: velchat:// (routed by RootNavigator linking config). -->
        <intent-filter android:label="@string/app_name">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="velchat" />
        </intent-filter>
      </activity>

      <!-- ── Push (ADR 0008) ────────────────────────────────────────────────
           All three components are exported="false": nothing outside the app has
           any business starting them. The FCM service is the exception the system
           itself binds to, which it is allowed to do via its signature-checked
           MESSAGING_EVENT action without the component being exported. -->

      <!-- Receives data-only pushes. Runs with NO React context when the app is
           killed — which is the entire point: it posts the notification AND sends
           the delivery receipt from Kotlin. -->
      <service
        android:name=".push.VelChatMessagingService"
        android:exported="false"
        android:directBootAware="false">
        <intent-filter>
            <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
      </service>

      <!-- Reply / Mark as read / Mute, handled without opening the app. -->
      <receiver
        android:name=".push.PushActionReceiver"
        android:exported="false" />

      <!-- Boots JS only for an action the user deliberately took (a reply needs the
           real session; an incoming push does not). Bounded to 30 s. -->
      <service
        android:name=".push.PushHeadlessService"
        android:exported="false" />

      <!-- Applied by FCM when a notification-type push arrives with no handler. The
           backend sends data-only messages so these should never be used, but a
           missing icon here renders as a blank square rather than an error, and that
           is not a failure mode worth leaving open. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/push_accent" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="velchat.messages.v1" />
    </application>
</manifest>
